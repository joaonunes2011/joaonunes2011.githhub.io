/* Cores principais */
:root {
  --azul: #8dbeeb;
  --preto: #1e1e1e;
  --texto: #111;
  --fundo: #fff;
  --borda: #1e1e1e;
  --sombra: #1e1e1e;
}

/* Cores do modo escuro */
:root.tema-escuro {
  --azul: #263746;
  --preto: #050505;
  --texto: #f5f5f5;
  --fundo: #111;
  --borda: #f5f5f5;
  --sombra: #000;
}

/* Configuraçao geral */
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: var(--fundo);
  color: var(--texto);
  font-family: Arial, Helvetica, sans-serif;
}

button,
input {
  font: inherit;
  color: inherit;
}

button {
  cursor: pointer;
}

button:focus-visible,
input:focus-visible,
a:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 3px;
}

/* Moldura preta externa */
.moldura {
  width: min(1193px, 100%);
  min-height: 735px;
  margin: 22px auto;
  padding: 55px 91px 52px;
  background: var(--preto);
}

/* Painel azul central */
.painel {
  min-height: 583px;
  padding: 0 38px 24px;
  position: relative;
  color: var(--texto);
  background: var(--azul);
  border: 1px solid var(--borda);
}

/* Cabeçalho */
.cabecalho {
  min-height: 62px;
  display: flex;
  align-items: center;
  gap: 0;
  white-space: nowrap;
}

/* Nome da loja */
.marca {
  margin-right: auto;
  color: inherit;
  font-size: 20px;
  font-weight: 700;
  text-decoration: none;
}

/* Menu de navegação */
.navegacao {
  display: flex;
  align-items: center;
}

.nav-link {
  padding: 12px 13px;
  border: 0;
  border-bottom: 2px solid transparent;
  background: transparent;
  font-size: 15px;
}

.nav-link:hover,
.nav-link.ativo {
  border-bottom-color: var(--borda);
}

/* Pesquisa */
.busca {
  width: 272px;
  height: 30px;
  display: flex;
  margin-left: 10px;
  border: 1px solid var(--borda);
}

.busca input {
